# ============================================================
#  ExcelToJsonCs 项目 .gitignore
#  只跟踪源码与示例，忽略“可重新生成的产物 / 临时文件”。
# ============================================================

# ---------- 工具运行期产生的临时文件 ----------
# 增量导出缓存：每次运行会按源表自动重建
.excel_export_cache.json
# 运行日志
export_log.txt
*.log

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/__pycache__/

# ---------- 虚拟环境 ----------
venv/
.venv/
env/
ENV/

# ---------- PyInstaller 打包产物（可重新构建）----------
# 中间产物
build/
# 打包结果（exe 体积大，建议走 GitHub Releases 分发）
dist/
*.manifest

# ---------- Office / Excel 临时文件 ----------
~$*
*.tmp

# ---------- 编辑器 / IDE ----------
.vscode/
.idea/
*.swp
*.swo
*~

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 本机 AI 助手记忆（不上传）----------
.workbuddy/
